# 本番ビルド（npm run build / mode=production）用の環境変数。
# バックエンド URL は公開情報（フロント bundle に埋め込まれ、Cloud Run は
# allow-unauthenticated）で secret ではないためコミットする。
# これにより本番ビルドは VITE_API_BASE_URL 必須のガードを満たしつつ、
# デプロイパイプライン（Dockerfile / deploy.yml）は無改修で通る。
VITE_API_BASE_URL=https://club-galaxy-backend-733762302128.asia-northeast1.run.app
